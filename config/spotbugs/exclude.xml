<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">
  <!--
    Project-specific SpotBugs suppressions for confirmed false positives.

    Prefer fixing the code over suppressing; only suppress with a justification
    comment naming the bug pattern and why the finding does not apply.
  -->

  <!--
    EI_EXPOSE_REP2: the constructor stores the injected SnsClient reference
    directly. AWS SDK v2 clients (SnsClient) are immutable and thread-safe by
    design; there is nothing mutable to defensively copy. Applies to the
    NotificationService in each service module (gateway, world, ...).
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="~.*NotificationService"/>
  </Match>

  <!--
    EI_EXPOSE_REP2: the constructor stores the injected SnsClient reference
    directly. AWS SDK v2 clients are immutable and thread-safe by design; there
    is nothing mutable to defensively copy. Applies to the SnsTopicResolver in
    the common module, which is a stateless ARN resolver wrapping the client.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="~.*SnsTopicResolver"/>
  </Match>

  <!--
    EI_EXPOSE_REP2: the constructor stores injected SnsClient and ObjectMapper
    references directly. SnsClient is an immutable AWS SDK v2 client, and the
    tools.jackson ObjectMapper is thread-safe once configured; both are standard
    Spring singleton-DI patterns with nothing mutable to defensively copy.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="~.*TickScheduler"/>
  </Match>
</FindBugsFilter>
